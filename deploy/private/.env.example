# APOLLO Private - 環境設定テンプレート
#
# このファイルを `.env` にコピーして値を埋めてください。
#   cp deploy/private/.env.example deploy/private/.env
#
# ==================================================================
# 1. APOLLO モード
# ==================================================================
# Dockerfile 側で APOLLO_MODE=private が固定されているので基本変更不要。
# ローカル開発で `just dev` を使うときだけ "hosted" に切り替える想定。
APOLLO_MODE=private

# ==================================================================
# 2. 永続化データのマウント先（ホスト側パス）
# ==================================================================
# この下に embedding cache, jobs, users.yml が作成される。
# 相対パスなら docker-compose.yml の実行ディレクトリ基準。
# 本番運用では絶対パス推奨 (例: /srv/apollo-data)
APOLLO_DATA_DIR=./apollo-data

# ==================================================================
# 3. LM Studio / Ollama エンドポイント
# ==================================================================
# コンテナからホスト (= LM Studio / Ollama) への接続。
#
# - Docker Desktop (Mac/Windows): host.docker.internal でホスト到達可
# - Linux Docker: docker-compose.yml で extra_hosts を設定済なので同じく OK
# - LAN 上の別マシン: IP を直接指定 (例: http://192.168.1.22:1234/v1)
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# LM Studio は API キー不要。Ollama も同様。dummy 値を入れておく
LM_STUDIO_API_KEY=dummy

# ==================================================================
# 4. モデル名（LM Studio / Ollama 側にロード済みの ID と一致させる）
# ==================================================================
# 埋め込みモデル: Qwen3-Embedding-4B 推奨 (2560 次元、多言語 SOTA)
# LM Studio なら `text-embedding-qwen3-embedding-4b`
# Ollama なら `bge-m3` などでも OK (.yml 側で切り替え)
APOLLO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b

# チャット + Vision 対応モデル (VOYAGER のマルチモーダル入力用)
# Gemma 4 26B がベストだが、Qwen3-VL でも動作する
APOLLO_CHAT_MODEL=google/gemma-4-26b-a4b

# ==================================================================
# 5. 認証 cookie 署名キー
# ==================================================================
# 以下のコマンドで生成して差し替えること（本番では必須、テスト値は NG）:
#   openssl rand -hex 32
# また、.env と同じ値を deploy/private/users.yml の cookie.key にも入れる
APOLLO_COOKIE_SECRET=CHANGE_ME_openssl_rand_hex_32_64chars

# ==================================================================
# 6. Streamlit の挙動（任意）
# ==================================================================
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
